---
import blendImage from '@/assets/images/home/blend.jpg'
import { homeRepository } from '@/data/home/DatoCmsHomeRepository'
import HeroBranchShowcase from '@/presentation/home/HeroBranchShowcase'
import JapanCultivarMap from '@/presentation/home/JapanCultivarMap'
import ProductItem from '@/presentation/home/ProductItem.astro'
import Layout from '@/presentation/layout/Layout.astro'
import MobileOrderBar from '@/presentation/product/MobileOrderBar'
import OrderButton from '@/presentation/product/OrderButton'

const homePageData = await homeRepository.getHome()
const cultivars = homePageData.allCultivars
const blends = homePageData.allBlends
const fusions = homePageData.allFusions

const fusionFeaturedId =
  fusions.filter((p) => p.price != null).find((p) => p.bestSeller)?.id ??
  fusions.filter((p) => p.price != null).find((p) => p.recommended)?.id
---

<Layout>
 <article class="relative w-full overflow-hidden">
    {/* Hero Section */}
    <section id="hero" class="relative w-full pt-6 pb-20 lg:pt-10 lg:pb-28 bg-linear-to-b from-shamrock-950 via-shamrock-900 to-black text-shamrock-50 overflow-hidden">

      {/* Decorative ambient background glows */}
      <div class="absolute inset-0 pointer-events-none overflow-hidden">
        <div class="absolute top-10 right-1/4 w-96 h-96 bg-shamrock-400/10 rounded-full blur-3xl animate-pulse"></div>
        <div class="absolute bottom-10 left-10 w-96 h-96 bg-malachite-500/10 rounded-full blur-3xl animate-pulse" style="animation-delay: 1.5s;"></div>
        <div class="absolute inset-0 bg-[radial-gradient(var(--color-shamrock-500)_1px,transparent_1px)] [background-size:32px_32px] opacity-15"></div>
      </div>
      
      <div class="container relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center min-h-130 lg:min-h-155">
          
          {/* Left Content Side */}
          <div class="lg:col-span-6 flex flex-col items-start justify-center gap-y-6">
            
            {/* Top Announcement Pill */}
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 hover:bg-white/15 backdrop-blur-md border border-white/15 text-xs text-shamrock-200 transition-all duration-300 shadow-sm">
              <span class="flex h-2 w-2 rounded-full bg-amber-400 animate-ping"></span>
              <span class="font-semibold text-amber-300 font-poppins tracking-wider uppercase text-[11px]">New Branch</span>
              <span class="text-white/40">•</span>
              <span class="font-sarabun text-shamrock-100">เตรียมพบกับสาขาใหม่ "โคราช" เร็วๆ นี้</span>
            </div>

            {/* Main Brand Heading */}
            <div class="space-y-3">
              <div class="flex items-center gap-2 text-shamrock-400 font-poppins text-xs font-semibold tracking-widest uppercase">
                <span>Authentic Japanese Matcha Bar</span>
                <span class="text-shamrock-600">|</span>
                <span class="font-sarabun text-shamrock-300">りゅう</span>
              </div>
              <h1 class="font-poppins text-4xl sm:text-5xl lg:text-[54px] font-extrabold leading-[1.08] tracking-tight text-balance text-white">
                <span>Your neighborhood</span>
                <span class="block text-transparent bg-clip-text bg-linear-to-r from-shamrock-200 via-malachite-200 to-shamrock-300">
                  authentic matcha.
                </span>
              </h1>
              <div class="h-1.5 w-24 rounded-full bg-linear-to-r from-shamrock-300 via-malachite-400 to-shamrock-500"></div>
            </div>

            {/* Subtitle Description */}
            <p class="text-base sm:text-lg text-shamrock-100/90 font-sarabun font-light leading-relaxed max-w-xl text-balance">
              สัมผัสมัทฉะแท้เกรดพิธีการ (Ceremonial Grade) คัดสรรจากแหล่งปลูกชั้นนำทั่วญี่ปุ่น ชงสดด้วยความพิถีพิถันทุกแก้ว พร้อมให้บริการแล้ววันนี้ที่กรุงเทพฯ (เสนานิคม) และสาขาใหม่ที่โคราช
            </p>

            {/* CTA Buttons */}
            <div class="flex flex-col sm:flex-row flex-wrap gap-3.5 w-full sm:w-auto pt-2">
              <OrderButton
                className="w-full sm:w-auto bg-shamrock-200 hover:bg-shamrock-100 text-shamrock-950 px-8 py-3.5 text-base font-bold rounded-2xl transition-all duration-300 shadow-lg shadow-shamrock-900/30 hover:shadow-xl hover:shadow-shamrock-900/40 hover:scale-[1.02] cursor-pointer"
                client:only="react"
              >
                สั่งเดลิเวอรี (Order Now)
              </OrderButton>
              <a 
                href="#menu" 
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 hover:border-shamrock-300/50 text-white px-6 py-3.5 text-base rounded-2xl font-medium transition-all duration-300 font-sarabun"
              >
                <span>สำรวจเมนูมัทฉะ</span>
                <svg class="h-4 w-4 text-shamrock-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </a>
            </div>

            {/* Trust Anchor Metrics */}
            <div class="grid grid-cols-3 gap-4 pt-4 border-t border-white/10 w-full max-w-lg">
              <div>
                <p class="font-poppins text-lg sm:text-xl font-bold text-shamrock-200">100%</p>
                <p class="text-[11px] sm:text-xs text-shamrock-300/80 font-sarabun">Ceremonial Grade</p>
              </div>
              <div>
                <p class="font-poppins text-lg sm:text-xl font-bold text-shamrock-200">2 สาขา</p>
                <p class="text-[11px] sm:text-xs text-shamrock-300/80 font-sarabun">กรุงเทพฯ &amp; โคราช</p>
              </div>
              <div>
                <p class="font-poppins text-lg sm:text-xl font-bold text-shamrock-200">Fresh Whisked</p>
                <p class="text-[11px] sm:text-xs text-shamrock-300/80 font-sarabun">ชงสดตามออเดอร์</p>
              </div>
            </div>

          </div>

          {/* Right Interactive Branch & Storefront Showcase */}
          <div class="lg:col-span-6 flex items-center justify-center w-full">
            <HeroBranchShowcase client:load />
          </div>

        </div>
      </div>

      {/* Elegant Wave divider */}
      <div class="absolute bottom-0 left-0 right-0 pointer-events-none">
        <svg class="w-full h-10 sm:h-14 lg:h-18 text-shamrock-50" viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
          <path d="M0 120L60 105C120 90 240 60 360 45C480 30 600 30 720 37.5C840 45 960 60 1080 67.5C1200 75 1320 75 1380 75L1440 75V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0Z" fill="currentColor"/>
        </svg>
      </div>
    </section>

    {/* Single Cultivar Section */}
    <section id="menu" class="transform-gpu py-12 lg:py-24 bg-shamrock-50 relative z-10 overflow-hidden">
      {/* Background decoration */}
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full max-w-7xl pointer-events-none opacity-50">
        <div class="absolute top-20 left-10 w-64 h-64 bg-shamrock-50 rounded-full blur-3xl mix-blend-multiply"></div>
        <div class="absolute bottom-20 right-10 w-80 h-80 bg-malachite-50 rounded-full blur-3xl mix-blend-multiply"></div>
      </div>

      <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative">
        <div class="mb-12 lg:mb-16 text-center">
            <div class="inline-flex items-center gap-2">
              <span class="h-px w-8 bg-shamrock-400"></span>
              <span class="text-shamrock-600 font-medium text-sm">Authentic Taste</span>
              <span class="h-px w-8 bg-shamrock-400"></span>
            </div>
            <h2 class="mt-3 text-3xl font-bold text-gray-900 lg:text-4xl font-esteban">
                Single Cultivar Matcha
            </h2>
            <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto font-sarabun">
                สัมผัสรสชาติอันเป็นเอกลักษณ์ของมัทฉะสายพันธุ์เดี่ยว ที่ผ่านการคัดสรรอย่างพิถีพิถันจากแหล่งเพาะปลูกชั้นยอด
            </p>
        </div>
        <JapanCultivarMap cultivars={cultivars} client:load />
      </div>
    </section>

    {/* Blend Section */}
    <section class="relative z-10 overflow-hidden bg-white py-14 lg:py-20">
      <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid items-start gap-12 lg:grid-cols-[minmax(280px,0.8fr)_minmax(0,1.2fr)] lg:gap-20">
          <div class="lg:sticky lg:top-10">
            <div class="relative overflow-hidden rounded-[1rem] bg-shamrock-950 shadow-2xl shadow-shamrock-950/15">
              <img
                src={blendImage.src}
                alt="A bamboo chasen whisking bright green matcha"
                class="aspect-[4/5] w-full object-cover"
                loading="lazy"
              />
              <div class="absolute inset-x-0 bottom-0 bg-linear-to-t from-shamrock-950/90 via-shamrock-950/20 to-transparent p-6 pt-24 text-white sm:p-8 sm:pt-32">
                <p class="font-poppins text-xs font-semibold uppercase tracking-[0.18em] text-shamrock-200">
                  RYUU Signature House Blend
                </p>
                <p class="mt-2 max-w-xs font-sarabun text-lg leading-relaxed text-white/90">
                  สูตรเฉพาะของเรา ผสมให้ได้ความกลมกล่อมในทุกแก้ว
                </p>
              </div>
            </div>
          </div>

          <div>
            <div class="mb-8 max-w-2xl">
              <p class="font-poppins text-sm font-semibold uppercase tracking-[0.16em] text-shamrock-700">
                Perfect harmony
              </p>
              <h2 class="mt-3 font-esteban text-3xl font-bold leading-tight text-gray-950 lg:text-4xl">
                House Blends
              </h2>
              <p class="mt-4 max-w-xl font-sarabun text-lg leading-relaxed text-gray-600">
                การผสมผสานมัทฉะหลากหลายสายพันธุ์อย่างลงตัว เพื่อให้ได้รสชาติและกลิ่นสัมผัสที่ซับซ้อนและน่าจดจำ
              </p>
            </div>

            <ul class="divide-y divide-gray-300/80 border-y border-gray-300/80">
              {blends.map((blend, index) => (
                <li class="py-5 sm:py-6">
                  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
                    <div class="min-w-0">
                      <div class="flex flex-wrap items-center gap-2.5">
                        <span class="font-poppins text-xs font-semibold tabular-nums text-shamrock-700">
                          0{index + 1}
                        </span>
                        <h3 class="font-poppins text-lg font-bold text-gray-950 sm:text-xl">
                          {blend.name}
                        </h3>
                        {blend.servingPrices.clear == null && blend.servingPrices.latte == null ? (
                          <span class="rounded-full bg-gray-900 px-2.5 py-1 font-poppins text-[10px] font-bold uppercase tracking-wide text-white">
                            Coming soon
                          </span>
                        ) : (
                          <>
                            {blend.bestSeller && (
                              <span class="rounded-full bg-amber-100 px-2.5 py-1 font-poppins text-[10px] font-bold uppercase tracking-wide text-amber-800">
                                Best seller
                              </span>
                            )}
                            {blend.recommended && (
                              <span class="rounded-full bg-shamrock-100 px-2.5 py-1 font-poppins text-[10px] font-bold uppercase tracking-wide text-shamrock-800">
                                Recommended
                              </span>
                            )}
                          </>
                        )}
                      </div>
                      <p class="mt-1.5 max-w-2xl font-sarabun text-sm leading-relaxed text-gray-600 sm:text-base">
                        {blend.concept}
                      </p>
                      <div class="mt-3 flex flex-wrap gap-1.5">
                        {blend.tasteNote.split(',').map((note) => (
                          <span class="rounded-full border border-shamrock-200 bg-shamrock-50 px-2.5 py-0.5 font-poppins text-[11px] font-medium uppercase tracking-wide text-shamrock-800">
                            {note.trim()}
                          </span>
                        ))}
                      </div>
                    </div>

                    <div class="flex shrink-0 items-center gap-3 border-t border-gray-300/70 pt-3 sm:min-w-40 sm:flex-col sm:items-end sm:gap-0.5 sm:border-0 sm:pt-1">
                      <span class="font-poppins text-[10px] font-semibold uppercase tracking-[0.16em] text-gray-500">
                        Serving price
                      </span>
                      <div class="flex items-baseline gap-2.5 font-poppins">
                        <span class="text-sm font-bold text-shamrock-800 sm:text-base">
                          {blend.servingPrices.clear == null ? '-' : `฿${blend.servingPrices.clear}`}
                          <small class="ml-1 text-[11px] font-medium text-gray-500">clear</small>
                        </span>
                        <span class="text-sm font-bold text-shamrock-800 sm:text-base">
                          {blend.servingPrices.latte == null ? '-' : `฿${blend.servingPrices.latte}`}
                          <small class="ml-1 text-[11px] font-medium text-gray-500">latte</small>
                        </span>
                      </div>
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* Fusion & Fancy Section */}
    <section class="py-12 lg:py-24 bg-shamrock-50 relative z-10">
      <div class="container mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-12 lg:mb-16 text-center">
            <div class="inline-flex items-center gap-2">
              <span class="h-px w-8 bg-shamrock-400"></span>
              <span class="text-shamrock-600 font-medium text-sm">Playful Creations</span>
              <span class="h-px w-8 bg-shamrock-400"></span>
            </div>
            <h2 class="mt-3 text-3xl font-bold text-gray-900 lg:text-4xl font-esteban">
                Fusion &amp; Fancy
            </h2>
            <p class="mt-4 text-lg text-gray-600 max-w-2xl mx-auto font-sarabun">
                เมนูมัทฉะสร้างสรรค์ ผสมผสานวัตถุดิบและรสชาติที่ไม่เหมือนใคร พร้อมเสิร์ฟ
            </p>
        </div>
        <ul class="grid grid-cols-1 gap-6 xs:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 md:auto-rows-[1fr]">
            {fusions.map((fusion) => (
              <ProductItem product={fusion} featured={fusion.id === fusionFeaturedId} />
            ))}
        </ul>
      </div>
    </section>
  </article>
  <MobileOrderBar revealAfterId="hero" client:load />
</Layout>

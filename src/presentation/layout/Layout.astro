---
import '../../styles/global.css'
import GoogleAnalytics from '../analytics/GoogleAnalytics.astro'
import Head from '../seo/Head.astro'
import Footer from './Footer.astro'
import Header from './Header.astro'
---

<html lang="th" class="dark relative scroll-smooth" data-branch="bkk">
  <Head />
  <script is:inline>
    (() => {
      try {
        const saved = localStorage.getItem('ryuu_selected_branch')
        if (saved && (saved === 'bkk' || saved === 'korat')) {
          document.documentElement.dataset.branch = saved
        }
      } catch (e) {}
    })()
  </script>
  <GoogleAnalytics />
  <body class="relative">
    <Header />
    <slot />
    <Footer />
  </body>
</html>

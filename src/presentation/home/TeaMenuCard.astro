---
import { Picture } from 'astro:assets'
import type { CoverImage, ServingPrices } from '@/domain/product/types'

type Props = {
  name: string
  metaLabel: string
  metaValue: string
  tasteNote?: string
  servingPrices: ServingPrices
  coverImage: CoverImage
  bestSeller?: boolean
  recommended?: boolean
  featured?: boolean
}
const {
  name,
  metaLabel,
  metaValue,
  tasteNote,
  servingPrices,
  coverImage,
  bestSeller = false,
  recommended = false,
  featured = false,
} = Astro.props

const isComingSoon = servingPrices.clear == null && servingPrices.latte == null

const tasteNotes = tasteNote
  ?.split(',')
  .map((tn) => tn.trim())
  .filter(Boolean)
---

<div
  class:list={[
    'group relative flex flex-col justify-between overflow-hidden rounded-2xl bg-white border border-gray-100 shadow-sm transition-all duration-500 hover:-translate-y-1 hover:shadow-xl hover:shadow-shamrock-900/5',
    featured && 'md:col-span-2 md:row-span-2',
  ]}
>
  <div class:list={['relative overflow-hidden bg-gray-50', featured ? 'aspect-16/9 md:aspect-4/3' : 'aspect-3/2']}>
    <Picture
      src={coverImage.responsiveImage.src}
      sizes={coverImage.responsiveImage.sizes}
      srcset={coverImage.responsiveImage.srcSet}
      width={coverImage.responsiveImage.width}
      height={coverImage.responsiveImage.height}
      alt={name}
      decoding={"async"}
      densities={[1.5, 2]}
      loading="eager"
      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
    />

    {/* Badges container */}
    <div class="absolute top-3 left-3 flex flex-col gap-2 z-10">
      {
        isComingSoon ? (
          <span class="inline-flex items-center rounded-full bg-gray-900/90 px-3 py-1 text-xs font-bold text-white shadow-sm backdrop-blur-md border border-gray-700">
            Coming Soon
          </span>
        ) : (
          <>
            {bestSeller && (
              <span class="inline-flex items-center rounded-full bg-white/95 px-3 py-1 text-xs font-bold text-shamrock-700 shadow-sm backdrop-blur-md border border-shamrock-100">
                Best Seller
              </span>
            )}
            {recommended && (
              <span class="inline-flex items-center rounded-full bg-amber-50/95 px-3 py-1 text-xs font-bold text-amber-700 shadow-sm backdrop-blur-md border border-amber-100">
                Recommended
              </span>
            )}
          </>
        )
      }
    </div>
  </div>

  <div class:list={['flex flex-1 flex-col gap-3 p-5', featured && 'md:p-6']}>
    <div>
      <h3 class:list={['font-poppins font-bold text-gray-900 group-hover:text-shamrock-700 transition-colors duration-300', featured ? 'text-xl md:text-2xl' : 'text-lg']}>
        {name}
      </h3>
      <p class="mt-1 text-sm text-gray-500 font-sarabun">
        <span class="font-medium text-gray-600">{metaLabel}:</span> {metaValue}
      </p>
    </div>

    {
      tasteNotes && tasteNotes.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {tasteNotes.map((tn) => (
            <span class="inline-flex items-center rounded bg-shamrock-50 px-2 py-1 font-poppins text-xs font-medium text-shamrock-600 uppercase tracking-wide border border-shamrock-100">
              {tn}
            </span>
          ))}
        </div>
      )
    }

    {/* Static serving price tags — display only, not selectable controls */}
    <div class="mt-auto flex flex-wrap gap-2 border-t border-gray-50 pt-3">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-shamrock-50/70 px-3 py-1.5 text-xs font-semibold text-shamrock-800 border border-shamrock-100">
        <svg class="h-3.5 w-3.5 text-shamrock-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <title>Clear</title>
          <path d="M12 2.5s6 7.2 6 11.5a6 6 0 1 1-12 0c0-4.3 6-11.5 6-11.5Z" />
        </svg>
        Clear: {servingPrices.clear == null ? '-' : `฿${servingPrices.clear}`}
      </span>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-shamrock-50/70 px-3 py-1.5 text-xs font-semibold text-shamrock-800 border border-shamrock-100">
        <svg class="h-3.5 w-3.5 text-shamrock-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <title>Latte</title>
          <path d="M5 8h11l-.8 9.2a2 2 0 0 1-2 1.8H7.8a2 2 0 0 1-2-1.8L5 8Z" />
          <path d="M16 9.5h1.5a2.5 2.5 0 0 1 0 5H16" />
          <path d="M9 4.5c-.7.6-1 1.1-1 1.8s.3 1.2 1 1.8" />
        </svg>
        Latte: {servingPrices.latte == null ? '-' : `฿${servingPrices.latte}`}
      </span>
    </div>
  </div>
</div>

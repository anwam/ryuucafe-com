---
import { Picture } from 'astro:assets'
import HeaderMenus from './HeaderMenus'
import RyuuLogo from '../assets/images/main-logo.webp'
---

<header class="sticky top-0 z-header h-12 bg-base-100 shadow lg:h-16">
  <nav class="navbar px-0 max-w-screen-lg mx-auto h-full">
    <div class="navbar-start flex gap-x-1 md:gap-x-2">
      <Picture
        class="hidden aspect-square rounded-full text-base/none md:block"
        width={44}
        height={44}
        src={RyuuLogo}
        densities={[1, 2]}
        alt="RYUU Matcha Logo"
      />
      <HeaderMenus vairiant="mobile" client:load />
      <div class="flex flex-col">
        <h1 class="text-lg font-bold">RYUU りゅう</h1>
      </div>
    </div>
    <div class="navbar-center flex flex-grow flex-row md:flex-col"></div>
    <HeaderMenus vairiant="desktop" client:load />
  </nav>
</header>

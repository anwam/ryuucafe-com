---
import { Picture } from 'astro:assets'
import type { Product } from '../types'

type Props = {
  product: Product
}
const { product } = Astro.props
---

<div
  class="relative row-span-5 grid grid-rows-subgrid gap-1 overflow-hidden bg-base-100 shadow"
>
  <Picture
    src={product.coverImage.responsiveImage.src}
    sizes={product.coverImage.responsiveImage.sizes}
    srcset={product.coverImage.responsiveImage.srcSet}
    width={product.coverImage.responsiveImage.width}
    height={product.coverImage.responsiveImage.height}
    alt={product.name}
    decoding={"async"}
    densities={[1.5, 2]}
    loading="eager"
  />
  <div class="flex flex-wrap gap-x-1 gap-y-1 px-1.5">
    <h3 class="font-extrabold text-green-700">{product.name}</h3>
  </div>
  <div class="flex items-center px-2">
    {
      product.bestSeller && (
        <div class="badge badge-accent hidden rounded-full px-2 py-1 font-ibm-plex-sans-thai text-xs text-white md:inline-flex">
          ขายดี
        </div>
      )
    }
    {
      product.recommended && (
        <div class="badge bg-green-700 shadow-none border-none hidden rounded-full px-2 py-1 font-ibm-plex-sans-thai text-xs text-white md:inline-flex">
          แนะนำ
        </div>
      )
    }
  </div>
  <div class="px-1.5 md:px-2">
    {
      product.description && (
        <p class="whitespace-pre-line text-pretty text-xs text-neutral-600">
          {product.description}
        </p>
      )
    }
  </div>
  <div class="px-1.5 py-0.5 md:px-2 md:py-2">
    {
      product.tasteNote && (
        <div class="flex flex-row flex-wrap items-center gap-x-1 gap-y-1">
          {product.tasteNote
            .split(",")
            .map((tn) => tn.trim())
            .map((tn) => (
              <span class="rounded-box border border-green-700 px-1 py-0.5 font-poppins text-[0.625rem] text-green-700">
                {tn}
              </span>
            ))}
        </div>
      )
    }
  </div>
</div>
